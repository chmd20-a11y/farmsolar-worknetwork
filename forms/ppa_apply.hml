Left="140" Right="140" Top="140"/><ROW><CELL BorderFill="23" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="11119"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"><CHAR>한전근무직원* 유무</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="24" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="8771"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"><CHAR>성     명</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="24" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="11601"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"><CHAR>관     계</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="25" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="16494"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"><CHAR>근무부서</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="26" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="11119"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="68" Style="0"><TEXT CharShape="21"><CHAR>□ 있음   □ 없음</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="27" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="8771"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"/></P></PARALIST></CELL><CELL BorderFill="27" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="11601"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"/></P></PARALIST></CELL><CELL BorderFill="28" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="16494"><CELLMARGIN Bottom="283" Left="141" Right="141" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="56" Style="0"><TEXT CharShape="20"/></P></PARALIST></CELL></ROW></TABLE></TEXT><TEXT CharShape="100"><CHAR/></TEXT></P><P ParaShape="31" Style="25"><TEXT CharShape="101"><CHAR>* </CHAR></TEXT><TEXT CharShape="102"><CHAR>한전 근무직원이란, 신청자(법인 또는 조합인 경우 대표자, 지분소유자, 조합원 포함)의 4촌 이내 친족 </CHAR></TEXT><TEXT CharShape="103"><CHAR>및 그 배우자</CHAR></TEXT><TEXT CharShape="102"><CHAR> 중에 한국전력공사에 재직중인 임직원을 의미하며, 이에 해당하는 신청자(법인, 조합 포함)는</CHAR></TEXT><TEXT CharShape="94"><CHAR> 해당 내용에 대한 자율적인 정보제공 및 이용수집에 동의</CHAR></TEXT></P><P ParaShape="96" Style="25"><TEXT CharShape="104"/></P><P ParaShape="99" Style="0"><TEXT CharShape="84"><CHAR>귀사와 상기와 같이 전력구입계약 체결을 신청합니다.</CHAR></TEXT></P><P ParaShape="97" Style="24"><TEXT CharShape="92"><CHAR>   20   년     월     일   </CHAR></TEXT></P><P ParaShape="32" Style="24"><TEXT CharShape="92"><CHAR>전력구입계약 체결 신청자                   (서명<FWSPACE/>/<FWSPACE/>인)</CHAR></TEXT></P><P ParaShape="33" Style="24"><TEXT CharShape="95"/></P><P ParaShape="34" Style="25"><TEXT CharShape="105"><CHAR>※ 제출서류</CHAR></TEXT></P><P ParaShape="31" Style="25"><TEXT CharShape="94"><TABLE BorderFill="29" CellSpacing="0" ColCount="2" PageBreak="Cell" RepeatHeader="true" RowCount="3"><SHAPEOBJECT InstId="2124721331" Lock="false" NumberingType="Table" ZOrder="9"><SIZE Height="7026" HeightRelTo="Absolute" Protect="false" Width="47762" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="5203"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="67" Style="0"><TEXT CharShape="22"><CHAR>신 청 시</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="30" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="42559"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="70" Style="0"><TEXT CharShape="23"><CHAR>발전사업허가증, 내선설계도면, 발전설비 시험성적서, 개발행위허가서</CHAR></TEXT><TEXT CharShape="24"><CHAR>(허가대상의 경우)</CHAR></TEXT><TEXT CharShape="23"><CHAR>, </CHAR></TEXT></P><P ParaShape="70" Style="0"><TEXT CharShape="23"><CHAR>전력거래소 회원 탈퇴 또는 발전기 말소 확인서</CHAR></TEXT><TEXT CharShape="24"><CHAR>(대상일 경우)</CHAR></TEXT><TEXT CharShape="23"><CHAR>, </CHAR></TEXT></P><P ParaShape="70" Style="0"><TEXT CharShape="23"><CHAR>신재생에너지 공급인증서 잔여량 확인서</CHAR></TEXT><TEXT CharShape="24"><CHAR>(대상일 경우)</CHAR></TEXT><TEXT CharShape="25"><CHAR>,</CHAR></TEXT><TEXT CharShape="23"><CHAR> 사업자등록증</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="5203"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="67" Style="0"><TEXT CharShape="26"><CHAR>준 공 시</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="30" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="42559"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="70" Style="0"><TEXT CharShape="27"><CHAR>사용전검사 확인서, 안전관리자 선임 필증</CHAR></TEXT><TEXT CharShape="28"><CHAR>(사용전검사 필증 제출시 면제)</CHAR></TEXT><TEXT CharShape="27"><CHAR>, 계기시험성적서</CHAR></TEXT><TEXT CharShape="28"><CHAR>(대상일 경우)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="30" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="5203"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Squeeze" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="67" Style="0"><TEXT CharShape="23"><CHAR>계약체결시</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="30" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="42559"><CELLMARGIN Bottom="283" Left="510" Right="510" Top="283"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="70" Style="0"><TEXT CharShape="23"><CHAR>계좌이체거래약정서, 발전설비 특성자료</CHAR></TEXT><TEXT CharShape="25"><CHAR>(대상일 경우)</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE></TEXT><TEXT CharShape="106"><CHAR> </CHAR></TEXT></P><P ParaShape="71" Style="0"><TEXT CharShape="85"/></P><P ParaShape="35" Style="24"><TEXT CharShape="30"><CHAR>【개인정보 수집 및 이용 동의서</CHAR></TEXT><TEXT CharShape="31"><CHAR>】</CHAR></TEXT></P><P ParaShape="36" Style="24"><TEXT CharShape="32"/></P><P ParaShape="41" Style="24"><TEXT CharShape="32"><TABLE BorderFill="29" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="2"><SHAPEOBJECT InstId="2124721317" Lock="false" NumberingType="Table" ZOrder="1"><SIZE Height="41206" HeightRelTo="Absolute" Protect="false" Width="47915" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="32929" Protect="false" RowAddr="0" RowSpan="1" Width="47915"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Top"><P ParaShape="72" Style="0"><TEXT CharShape="33"/></P><P ParaShape="72" Style="0"><TEXT CharShape="34"><CHAR>한국전력은 전력구입계약과 관련된 서비스제공에 필요한 개인정보의 수집·이용을 위하여 「개인정보보호법」 </CHAR></TEXT><TEXT CharShape="35"><CHAR>제15조(개인정보의 수집·이용), 제22조(동의를 받는 방법)에 따라 귀하의 동의를 받고자 합니다.</CHAR></TEXT></P><P ParaShape="72" Style="0"><TEXT CharShape="33"/></P><P ParaShape="73" Style="0"><TEXT CharShape="36"><CHAR>1. 수집․이용 항목</CHAR></TEXT></P><P ParaShape="73" Style="0"><TEXT CharShape="36"><TABLE BorderFill="29" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="4"><SHAPEOBJECT InstId="2124721318" Lock="false" NumberingType="Table" ZOrder="4"><SIZE Height="9028" HeightRelTo="Absolute" Protect="false" Width="46080" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="31" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="3313"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="66" Style="0"><TEXT CharShape="37"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="31" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="19927"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="66" Style="0"><TEXT CharShape="37"><CHAR>&lt; 전력구입계약 신청자&gt;</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="31" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="22840"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>&lt; 전력구입계약신청 위임자 &gt;</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="3313"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="75" Style="0"><TEXT CharShape="36"><CHAR>필수항목</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="19927"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="11" Style="0"><TEXT CharShape="39"><CHAR>성명, (*)주민등록번호, 전화번호, 주소, 휴대전화번호, 이메일주소</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="22840"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="11" Style="0"><TEXT CharShape="39"><CHAR>- 위임받는 사람 : 성명, (*)주민등록번호, 주소</CHAR></TEXT></P><P ParaShape="76" Style="0"><TEXT CharShape="39"><CHAR>- 대리인 : 성명, 주민번호 앞 6자리, 연락처 </CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="3313"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="75" Style="0"><TEXT CharShape="36"><CHAR>선택</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="19927"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="11" Style="0"><TEXT CharShape="40"><CHAR>가족 중 한전근무직원 유무, 성명, 관계, 근무부서</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="22840"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="11" Style="0"><TEXT CharShape="39"><CHAR>없음</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="3" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="46080"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="11" Style="0"><TEXT CharShape="41"><CHAR>※</CHAR></TEXT><TEXT CharShape="108"><CHAR> 「분산에너지 활성화 특별법 시행령」 제19조에 따라 </CHAR></TEXT><TEXT CharShape="109"><CHAR>분산에너지사업자</CHAR></TEXT><TEXT CharShape="108"><CHAR>의 성명, 연락처 수집</CHAR></TEXT><TEXT CharShape="41"><CHAR> </CHAR></TEXT></P><P ParaShape="0" Style="0"><TEXT CharShape="41"><CHAR>(*) 주민등록번호는 전기사업법 시행령 제62조의3(고유식별정보의 처리)에 의해 수집</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="36"><CHAR>2. 수집․이용 목적</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="39"><CHAR>- </CHAR></TEXT><TEXT CharShape="42"><CHAR>전력구입계약신청, 계약, 시설부담금의 청구 및 납부처리, 구입전력비의 지급 등과 관련한 정보이용</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="43"><CHAR>- 전력구입계약 체결 및 이행과정의 부적절한 관여여부 조사 또는 기타 내부감사 목적</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="36"><CHAR>3. 이용․보유기간</CHAR></TEXT></P><P ParaShape="78" Style="0"><TEXT CharShape="44"><CHAR>- </CHAR></TEXT><TEXT CharShape="45"><CHAR>특정 법률에 정한 경우를 제외하고는 </CHAR></TEXT><TEXT CharShape="107"><CHAR>전력구입계약 해지후 최장 10년</CHAR></TEXT><TEXT CharShape="45"><CHAR>까지 보관합니다.</CHAR></TEXT><TEXT CharShape="46"><CHAR> 다만, 채권․채무 잔존시에는 채권․채무 정산시까지로 합니다.</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="36"><CHAR>4. 동의거부 권리 및 불이익 고지</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="39"><CHAR>- </CHAR></TEXT><TEXT CharShape="47"><CHAR>고객님께서는 개인정보 수집 동의를 거부하실 수 있습니다. 다만 미동의시 </CHAR></TEXT><TEXT CharShape="48"><CHAR>전력구입계약신청 등이 제한됩니다.</CHAR></TEXT></P><P ParaShape="77" Style="0"><TEXT CharShape="49"><TABLE BorderFill="29" CellSpacing="0" ColCount="3" PageBreak="Cell" RepeatHeader="true" RowCount="4"><SHAPEOBJECT InstId="2124721319" Lock="false" NumberingType="Table" ZOrder="2"><SIZE Height="6800" HeightRelTo="Absolute" Protect="false" Width="46028" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="283" Left="283" Right="283" Top="283"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="510" Right="510" Top="141"/><ROW><CELL BorderFill="32" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="8405"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>구분</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="32" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="8998"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>동의자 (성명)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="32" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="0" RowSpan="1" Width="28625"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>개인정보 수집 및 이용 (해당란에  표시)</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="8405"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>발전사업자</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="8998"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="114"><CHAR>§NAME§</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="28625"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="50"><CHAR>위의 내용에 동의합니다. ☐동의함   ☐동의하지 않음</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="8405"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>위임받는 사람</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="8998"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="50"/></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="28625"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="50"><CHAR>위의 내용에 동의합니다. ☐동의함   ☐동의하지 않음</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="8405"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="38"><CHAR>대리인</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="8998"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="50"/></P></PARALIST></CELL><CELL BorderFill="29" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="28625"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="50"><CHAR>위의 내용에 동의합니다. ☐동의함   ☐동의하지 않음</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR>  </CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="29" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="6482" Protect="false" RowAddr="1" RowSpan="1" Width="47915"><CELLMARGIN Bottom="141" Left="510" Right="510" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="79" Style="0"><TEXT CharShape="51"><CHAR>상기 본인은 위와 같이 개인정보 수집 및 이용에 동의합니다.</CHAR></TEXT></P><P ParaShape="79" Style="0"><TEXT CharShape="51"><CHAR>년      월      일</CHAR></TEXT></P><P ParaShape="80" Style="0"><TEXT CharShape="51"><CHAR>(발전사업자)성  명 :                   (인/서명)</CHAR></TEXT></P><P ParaShape="80" Style="0"><TEXT CharShape="51"><CHAR>(위임받는사람)성  명 :                   (인/서명)</CHAR></TEXT></P><P ParaShape="80" Style="0"><TEXT CharShape="51"><CHAR>(대리인)성  명 :                   (인/서명)</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="36" Style="24"><TEXT CharShape="32"/></P><P ParaShape="36" Style="24"><TEXT CharShape="32"/></P><P ParaShape="36" Style="24"><TEXT CharShape="32"/></P><P ParaShape="36" Style="24"><TEXT CharShape="32"/></P><P ParaShape="41" Style="24"><TEXT CharShape="32"/></P><P ParaShape="35" Style="24"><TEXT CharShape="32"><CHAR>【전력구입계약신청 · 전기사용신청 위임장】</CHAR></TEXT></P><P ParaShape="35" Style="24"><TEXT CharShape="32"><TABLE BorderFill="4" CellSpacing="0" ColCount="5" PageBreak="Cell" RepeatHeader="true" RowCount="6"><SHAPEOBJECT InstId="2124721320" Lock="false" NumberingType="Table" ZOrder="3"><SIZE Height="21156" HeightRelTo="Absolute" Protect="false" Width="47917" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Column" TreatAsChar="true" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="140" Left="140" Right="140" Top="140"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="5" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="3243" Protect="false" RowAddr="0" RowSpan="1" Width="47917"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="81" Style="0"><TEXT CharShape="52"><CHAR> </CHAR></TEXT><TEXT CharShape="53"><CHAR>전력구입계약신청·전기사용신청서의 작성내용이 틀림없음과 신청서상의 서명ㆍ날인은 본인이 직접하였음을 확인하고 위 업무 일체를 위임합니다.</CHAR></TEXT></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="33" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="2" Width="5017"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>위임하는</CHAR></TEXT></P><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>사람</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="6779"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="75" Style="0"><TEXT CharShape="52"><CHAR>성명(법인명)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="16805"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="82" Style="0"><TEXT CharShape="52"><CHAR>(인)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="6951"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="83" Style="0"><TEXT CharShape="52"><CHAR>주민등록번호</CHAR></TEXT></P><P ParaShape="83" Style="0"><TEXT CharShape="52"><CHAR>(법인번호)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="4" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="1" RowSpan="1" Width="12365"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="52"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="6779"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>주    소</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="3" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="2" RowSpan="1" Width="36121"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="52"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="33" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="2" Width="5017"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>위임받는</CHAR></TEXT></P><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>사람</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="6779"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="75" Style="0"><TEXT CharShape="52"><CHAR>성명(법인명)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="16805"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="82" Style="0"><TEXT CharShape="52"><CHAR>(인)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="3" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="6951"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="83" Style="0"><TEXT CharShape="52"><CHAR>주민등록번호</CHAR></TEXT></P><P ParaShape="83" Style="0"><TEXT CharShape="52"><CHAR>(법인번호)</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="4" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="3" RowSpan="1" Width="12365"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="52"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="1" ColSpan="1" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="4" RowSpan="1" Width="6779"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="74" Style="0"><TEXT CharShape="52"><CHAR>주    소</CHAR></TEXT></P></PARALIST></CELL><CELL BorderFill="4" ColAddr="2" ColSpan="3" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="1700" Protect="false" RowAddr="4" RowSpan="1" Width="36121"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="0" Style="0"><TEXT CharShape="52"/></P></PARALIST></CELL></ROW><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="5" Dirty="false" Editable="false" HasMargin="false" Header="false" Height="10533" Protect="false" RowAddr="5" RowSpan="1" Width="47917"><CELLMARGIN Bottom="141" Left="141" Right="141" Top="141"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ParaShape="84" Style="0"><TEXT CharShape="52"><CHAR> 1. </CHAR></TEXT><TEXT CharShape="54"><CHAR>다른 사람의 인장ㆍ서명 도용 등에 의해 허위로 위임장을 작성 신청한 경우에는 형법 제231조와</CHAR></TEXT><TEXT CharShape="55"><CHAR> 제232조의 규정에 의하여 사문서 </CHAR></TEXT><TEXT CharShape="52"><CHAR>위ㆍ변조죄로 5년 이하의 징역에 처하게 됩니다.</CHAR></TEXT></P><P ParaShape="85" Style="0"><TEXT CharShape="52"><CHAR> 2. </CHAR></TEXT><TEXT CharShape="56"><CHAR>전력구입계약신청을 위임받은 자는 「개인정보보호법」 제59조에 따라 </CHAR></TEXT><TEXT CharShape="57"><CHAR>전력구입계약신청 목적 외 용도로 위임인의 </CHAR></TEXT><TEXT CharShape="58"><CHAR>개인정보를 수집할 수 없</CHAR></TEXT><TEXT CharShape="59"><CHAR>으며</CHAR></TEXT><TEXT CharShape="60"><CHAR> 동 법 제21조 및 시행령 제16조에 전기사용신청 후 </CHAR></TEXT><TEXT CharShape="59"><CHAR>위임인의 개인정보를 지체없이 파기</CHAR></TEXT><TEXT CharShape="60"><CHAR>하여야 합니다. 이를 어길 경우 관계 법령에 의해 처벌받게 됩니다.</CHAR></TEXT></P><P ParaShape="86" Style="0"><TEXT CharShape="52"/></P><P ParaShape="87" Style="0"><TEXT CharShape="53"><CHAR>  ※ 대리로 오신분은 신분증 원본을 제시하시기 바랍니다.</CHAR></TEXT></P><P ParaShape="87" Style="0"><TEXT CharShape="53"><CHAR>     대리인 성명 :               , 주민번호(앞 6자리) :                 , 연락처 :</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="26" Style="24"><TEXT CharShape="61"/></P><P ColumnBreak="false" PageBreak="true" ParaShape="35" Style="24"><TEXT CharShape="29"><CHAR>【전력구입계약 주요내용 및 유의사항】</CHAR></TEXT></P><P ParaShape="49" Style="24"><TEXT CharShape="62"><TABLE BorderFill="4" CellSpacing="0" ColCount="1" PageBreak="Cell" RepeatHeader="true" RowCount="1"><SHAPEOBJECT InstId="2124721321" Lock="false" NumberingType="Table" TextWrap="TopAndBottom" ZOrder="0"><SIZE Height="71027" HeightRelTo="Absolute" Protect="false" Width="47872" WidthRelTo="Absolute"/><POSITION AffectLSpacing="false" AllowOverlap="false" FlowWithText="true" HoldAnchorAndSO="false" HorzAlign="Left" HorzOffset="0" HorzRelTo="Para" TreatAsChar="false" VertAlign="Top" VertOffset="0" VertRelTo="Para"/><OUTSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/></SHAPEOBJECT><INSIDEMARGIN Bottom="141" Left="141" Right="141" Top="141"/><ROW><CELL BorderFill="4" ColAddr="0" ColSpan="1" Dirty="false" Editable="false" HasMargin="true" Header="false" Height="109640" Protect="false" RowAddr="0" RowSpan="1" Width="47872"><CELLMARGIN Bottom="566" Left="141" Right="141" Top="566"/><PARALIST LineWrap="Break" LinkListID="0" LinkListIDNext="0" TextDirection="0" VertAlign="Center"><P ColumnBreak="false" PageBreak="false" ParaShape="37" Style="24"><TEXT CharShape="63"><COLDEF Count="1" Layout="Left" SameGap="0" SameSize="true" Type="Newspaper"/><CHAR>제1조 【전력구입계약 주요내용】</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 1. 한전과 신청자는 정부가 고시한 “소규모 신재생에너지 발전전력 등의 거래에 관한 지침”을 근거로 하여 전력구입계약을 체결합니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 2. 전력량계의 검침은 매월 1일에 실시하고, 통신망을 이용한 원격검침을 원칙으로 합니다. 이 경우 소요비용(통신비 등)은 한전과 계약자가 균분하여 부담합니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 3. 월간 수급전력량은 검침일에 전기계기에 시현된 계량값으로 합니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 4. 전력에 대한 요금단가는 정부 고시 제 9조에 정한 단가를 적용합니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 5. </CHAR></TEXT><TEXT CharShape="65"><CHAR>요금은 청구한 달의 말일에 지급합니다. 말일이 공휴일이거나 영업일이 아닐 경우 그 전일에 지급합니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 6. 자가용 발전설비 설치자인 경우, 태양광설비는 자기소비 후 남은 전력을, 태양광설비외의 발전설비는 연간 총 생산량의 30% 미만 범위에서 전력을 거래할 수 있습니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 7. </CHAR></TEXT><TEXT CharShape="66"><CHAR>전력구입계약 체결을 위한 배전망의 접속 및 이용 조건은 송·배전용 전기설비 이용규정을 따릅니다.</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 8. </CHAR></TEXT><TEXT CharShape="67"><CHAR>계약의 유효기간은 상업운전개시일로부터 기산해 1년이며 쌍방간 이의가 없을 경우 1년단위로 연장됩니다.</CHAR></TEXT></P><P ParaShape="39" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>제2조 【접수가 불가한 경우】</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 1. 신에너지 및 재생에너지 개발․이용․보급 촉진법 제2조 제1호의 규정에 의한 신․재생에너지를 이용한 발전설비가 아닌 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 2. </CHAR></TEXT><TEXT CharShape="69"><CHAR>신청자가 전기사업법 제7조 제1항의 규정에 의해 발전사업의 허가를 받지 아니한 경우 (자가용 설비는 예외)</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 3. 전기사업법 제2조 제19호의 규정에 의한 자가용전기설비를 설치하지 아니한 자가 자가용 전력구입계약을 신청한 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 4. 공급신뢰도 및 전기품질(전압, 주파수, 역률 등) 측면에서 우리회사 전력계통 및 다른 사람에 대한 전력공급에 악영향을 <FWSPACE/>미치는 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 5. 우리회사 및 다른 사람의 전기설비에 악영향을 미치는 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 6. 공중의 안전 및 다른 사람의 생명, 신체에 위해를 미치는 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 7. 제3조 (접수가 취소되는 경우) 2~8호에 따라 전력구입계약신청이 취소된 신청자가 취소일자로부터 1개월 이내에 동일한 발전사업 허가(자가용PPA의 경우 동일 발전구역의 동일 사업자)로 전력구입계약을 재신청하는 경우 </CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 8. 기타 법령 및 규정, 기술적 사유에 의해 전력구입계약을 접수하지 못하는 경우</CHAR></TEXT></P><P ParaShape="37" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>제3조 【접수가 취소되는 경우】</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 1. 신청자가 희망하는 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 2. </CHAR></TEXT><TEXT CharShape="70"><CHAR>신청자가 한전의 접속방안 안내 후 1개월이 되는 날까지 접속점 협의에 불응하거나 추가자료를 제출하지 않을 경우</CHAR></TEXT></P><P ParaShape="40" Style="24"><TEXT CharShape="64"><CHAR> 3. </CHAR></TEXT><TEXT CharShape="71"><CHAR>신청자가 기술검토비 청구서 발행일로부터 20일까지 입금하지 아니하여 입금최고를 받았으나, 최고</CHAR></TEXT><TEXT CharShape="64"><CHAR> 후 7일까지 입금하지 않을 경우</CHAR></TEXT></P><P ParaShape="42" Style="24"><TEXT CharShape="64"><CHAR> 4. 신청자가 접속공사비 청구서 발행일부터 30일까지 입금하지 아니하여 입금최고를 받았으나, 최고후 7일까지 입금하지 않을 경우</CHAR></TEXT></P><P ParaShape="43" Style="24"><TEXT CharShape="64"><CHAR> 5. 개발행위허가 대상임에도 비대상으로 허위 접수하거나, 접수시 제출한 개발행위허가 비대상 여부가 변경되었을 경우</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 6. 신청자가 접속공사비 입금일로부터 6개월이 경과했음에도 신청자의 사유로 접속공사 착공에 불응하거나 지연할 경우 </CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 7. 준공일로부터 6개월이 경과했음에도 신청자의 사유로 계약이 체결되지 않을 경우</CHAR></TEXT></P><P ParaShape="44" Style="24"><TEXT CharShape="64"><CHAR> </CHAR></TEXT></P><P ParaShape="44" Style="24"><TEXT CharShape="64"><CHAR> 8. </CHAR></TEXT><TEXT CharShape="72"><CHAR>발전사업허가 용량과 실제 시설용량의 차이가 10%를 초과하였으나, 신청자가 사업허가용량이나 </CHAR></TEXT><TEXT CharShape="64"><CHAR>실제시설용량을 변경하지 않는 경우 (사업용 전력구입계약에 한함)</CHAR></TEXT></P><P ParaShape="38" Style="24"><TEXT CharShape="64"><CHAR> 9. 발전사업허가의 사업준비기간이 만료되거나, 허가가 취소된 경우 (사업용 전력구입계약에 한함)</CHAR></TEXT></P><P ParaShape="45" Style="24"><TEXT CharShape="64"><CHAR> 10. 발전설비 설치장소가 다른 발전구역으로 변경되는 경우</CHAR></TEXT></P><P ParaShape="45" Style="24"><TEXT CharShape="64"><CHAR> 11. 연계용량 검토 결과 연계용량 부족 등으로 연계가 불가능하여 신청자에게 공용배전선로 신설·<LINEBREAK/>교체·보강 비용 부담을 안내하였으나, 신청자가 해당 비용을 부담할 의사가 없는 경우</CHAR></TEXT></P><P ParaShape="45" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>제4조 【접속공사비의 적용】 </CHAR></TEXT></P><P ParaShape="46" Style="24"><TEXT CharShape="64"><CHAR> 1. </CHAR></TEXT><TEXT CharShape="73"><CHAR>접속공사비 산정의 세부 기준은 송·배전용 전기설비 이용규정 제5장 2절의 배전접속공사비를 따릅니다.</CHAR></TEXT></P><P ParaShape="47" Style="24"><TEXT CharShape="73"><CHAR> 2. </CHAR></TEXT><TEXT CharShape="65"><CHAR>상업운전개시 이전에 전력구입계약 신청자가 사용전검사를 위한 시험가압을 사유로 전기공급의 일시정지</CHAR></TEXT><TEXT CharShape="73"><CHAR> 및 재공급을 요청하는 경우 신청자가 현장작업 수수료를 부담하여야 하며, 작업수수료 납부 이후 계기봉인 및 상업운전개시가 가능합니다. </CHAR></TEXT></P><P ParaShape="47" Style="24"><TEXT CharShape="73"><CHAR> 3. </CHAR></TEXT><TEXT CharShape="69"><CHAR>접속공사비 납부 후 제3조에 따라 접수가 취소되는 경우, 납부한 접속공사비에서 접속설비의</CHAR></TEXT><TEXT CharShape="74"><CHAR> 설치 및 철거에</CHAR></TEXT><TEXT CharShape="73"><CHAR> 소요된 비용과 기타 발생비용을 차감하고 그 잔액을 환불합니다.</CHAR></TEXT></P><P ParaShape="37" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>제5조 【계약전력 결정】</CHAR></TEXT></P><P ParaShape="48" Style="24"><TEXT CharShape="64"><CHAR> 1. </CHAR></TEXT><TEXT CharShape="71"><CHAR>신청 당시의 설비용량과 준공 후 설비용량(사용전검사 필증 용량)이 달라 계약전력이 증설되는 경우, 연계가능용량이 있는</CHAR></TEXT><TEXT CharShape="64"><CHAR> </CHAR></TEXT><TEXT CharShape="71"><CHAR>경우에만 연계가 가능하며, 연계가능한 경우 사용전검사일을 기준으로 신재생 감시·제어시스템 설치 대상 여부와 추가 접속공사비 청구 여부를 재검토합니다.</CHAR></TEXT></P><P ParaShape="88" Style="24"><TEXT CharShape="75"><CHAR>    </CHAR></TEXT><TEXT CharShape="66"><CHAR>(연계불가능한 경우 설비용량을 최초 제출한 신청서에 기재된 설비용량으로 정상화하여야 함)</CHAR></TEXT></P><P ParaShape="89" Style="24"><TEXT CharShape="64"><CHAR> 2. </CHAR></TEXT><TEXT CharShape="76"><CHAR>1항으로 인한 시설부담금 차액 발생으로 추가 접속공사비 청구를 받았으나 청구일로부터 30일까지 입금하지</CHAR></TEXT><TEXT CharShape="64"><CHAR> </CHAR></TEXT><TEXT CharShape="77"><CHAR>아니하여 입금최고를 받고, 최고 후 7일까지 입금하지 않을 경우 전력구입계약이 취소될 수 있음을 숙지합니다.</CHAR></TEXT></P><P ParaShape="37" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>제6조 【신재생발전기 감시·제어시스템】</CHAR></TEXT></P><P ParaShape="90" Style="0"><TEXT CharShape="75"><CHAR> 1. </CHAR></TEXT><TEXT CharShape="78"><CHAR>9</CHAR></TEXT><TEXT CharShape="79"><CHAR>0kW 이상 풍력, 태양광 및 연료전지 </CHAR></TEXT><TEXT CharShape="66"><CHAR>발전기로 전력구입계약을 신청하는 자(선접속 후제어 조건부로 </CHAR></TEXT><TEXT CharShape="64"><CHAR>접속하는 경우 90kW 미만 포함)는 신재생발전기 감시·제어시스템을 설치하고 운영하여야 합니다.</CHAR></TEXT><TEXT CharShape="75"><CHAR> </CHAR></TEXT></P><P ParaShape="90" Style="0"><TEXT CharShape="76"><CHAR> 2. 1항에 관한 세부 사항은 송배전용 전기설비 이용규정을 따릅니다.</CHAR></TEXT><TEXT CharShape="75"/></P><P ParaShape="37" Style="24"><TEXT CharShape="68"/></P><P ParaShape="37" Style="24"><TEXT CharShape="63"><CHAR>【선접속 후제어 조건부 접속 고객에 관한 특약사항】</CHAR></TEXT></P><P ParaShape="91" Style="0"><TEXT CharShape="79"><CHAR> 1. 선접속 후제어 조건부로 연계신청하는 경우 원격 출력제어를 위한 감시·제어설비 구축 이후 접속이 가능하며, 출력제어에 대한 한도나 보상 없이 비상시 사전고지 없이 출력제어가 발생할 수 있습니다.</CHAR></TEXT></P><P ParaShape="91" Style="0"><TEXT CharShape="79"><CHAR> 2. 선접속 후제어 조건부로 한전의 송배전용 전기설비를 이용(접속)하는 사업자가 감시·제어설비를 적절히 유지보수하지 않거나 송배전용 전기설비 이용규정 제29조 5항에 따른 출력제어를 이행하지 않는 경우 관련 규정에 따라 이용이 정지될 수 있습니다.</CHAR></TEXT></P><P ParaShape="91" Style="0"><TEXT CharShape="79"><CHAR> 3. 1순위 출력제어 조건은 송·배전선로 모두 보강 후 해제가 가능하며, 배전선로 보강이 필요한 경우에는 사업자가 비용을 부담하여야 합니다.</CHAR></TEXT></P><P ParaShape="91" Style="0"><TEXT CharShape="79"><CHAR> 4. 선접속 후제어 조건부로 전력구입계약을 신청하는 경우, 계약 체결 전에 부록5의 [송·배전용 선접속 후제어 접속동의서]를 작성하여 제출하여야 합니다.</CHAR></TEXT></P><P ParaShape="37" Style="24"><TEXT CharShape="75"/></P><P ParaShape="37" Style="24"><TEXT CharShape="75"/></P><P ParaShape="37" Style="24"><TEXT CharShape="75"><CHAR> </CHAR></TEXT><TEXT CharShape="63"><CHAR>상기내용을 읽고 숙지하였음을 확인합니다.  전력구입계약 신청자             (인)</CHAR></TEXT></P></PARALIST></CELL></ROW></TABLE><CHAR/></TEXT></P><P ParaShape="49" Style="24"><TEXT CharShape="62"/></P><P ParaShape="0" Style="0"><TEXT CharShape="0"/></P></SECTION></BODY><TAIL><SCRIPTCODE Type="JScript" Version="1.0"><SCRIPTHEADER></SCRIPTHEADER><SCRIPTSOURCE></SCRIPTSOURCE></SCRIPTCODE></TAIL></HWPML>